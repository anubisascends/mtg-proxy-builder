<Window x:Class="MTGFrameMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MTG Frame Mapper" Width="1300" Height="850" MinWidth="900" MinHeight="600"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <Color x:Key="WindowBg">#1E1E1E</Color>
            <Color x:Key="PanelBg">#252526</Color>
            <Color x:Key="InputBg">#3E3E42</Color>
            <Color x:Key="Border">#555555</Color>
            <Color x:Key="AccentBlue">#0078D4</Color>
            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBg}"/>
            <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBg}"/>
            <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
            <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>

            <Style x:Key="ToolBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#CCC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}" x:Name="Bd">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentBtn" TargetType="Button">
                <Setter Property="Background" Value="#0078D4"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}" x:Name="Bd">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#004578"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <TextBlock Text="Region:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="RegionPreset" Width="130" Background="#3E3E42" Foreground="White"
                          BorderBrush="#555555" FontSize="11" Padding="4,2" SelectedIndex="0">
                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#3E3E42"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#0078D4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="Art Box" Tag="art"/>
                    <ComboBoxItem Content="Name" Tag="name"/>
                    <ComboBoxItem Content="Mana Cost" Tag="manaCost"/>
                    <ComboBoxItem Content="Type Line" Tag="typeLine"/>
                    <ComboBoxItem Content="Rules Text" Tag="rulesText"/>
                    <ComboBoxItem Content="P/T Box" Tag="pt"/>
                    <ComboBoxItem Content="Set Symbol" Tag="setSymbol"/>
                    <ComboBoxItem Content="Collector Info" Tag="collector"/>
                </ComboBox>
                <Button Content="Draw Region" Style="{StaticResource ToolBtn}" Click="OnDrawRegion"
                        ToolTip="Click then drag on the image" Padding="8,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <Button Content="Copy to Folder" Style="{StaticResource ToolBtn}" Click="OnCopyToFolder"
                        ToolTip="Copy regions to all images in the same folder" Padding="8,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <Button Content="Save" Style="{StaticResource AccentBtn}" Click="OnSave" Padding="10,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <TextBlock x:Name="FrameLabel" Text="" Foreground="#888888" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0"/>
            </WrapPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Left: TreeView -->
            <Border Grid.Column="0" Background="#252526">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D30" Padding="8,6">
                        <TextBlock Text="Frame Browser" Foreground="#CCC" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <Border Grid.Row="1" Background="#2D2D30" Padding="8,4" BorderBrush="#333333" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="StatsLabel" Text="No folder loaded" Foreground="#888" FontSize="10"/>
                    </Border>

                    <TreeView Grid.Row="2" x:Name="FrameTree" Background="#252526" BorderThickness="0"
                              Foreground="#CCC" FontSize="11"
                              SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#CCC"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Center: Image canvas -->
            <Border Grid.Column="2" Background="#1A1A1A" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroll"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  PreviewMouseWheel="OnCanvasMouseWheel">
                        <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="FrameImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="True"
                                    MouseLeftButtonDown="OnCanvasMouseDown"
                                    MouseMove="OnCanvasMouseMove"
                                    MouseLeftButtonUp="OnCanvasMouseUp"
                                    Background="Transparent"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Zoom controls -->
                    <Border Background="#CC2D2D30" CornerRadius="4" Padding="6,3"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Padding="6,1" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                    Cursor="Hand" Click="OnZoomOut"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#CCC" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0" MinWidth="36" TextAlignment="Center"/>
                            <Button Content="+" Padding="6,1" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                    Cursor="Hand" Click="OnZoomIn"/>
                            <Border Width="1" Background="#555" Margin="6,2"/>
                            <Button Content="Fit" Padding="6,1" FontSize="11"
                                    Background="Transparent" Foreground="#AAA" BorderThickness="0"
                                    Cursor="Hand" Click="OnZoomFit"/>
                            <Button Content="1:1" Padding="6,1" FontSize="11"
                                    Background="Transparent" Foreground="#AAA" BorderThickness="0"
                                    Cursor="Hand" Click="OnZoomReset"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="3" Background="#333333"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right: Region list -->
            <Border Grid.Column="4" Background="#252526">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D30" Padding="8,6">
                        <TextBlock Text="Regions" Foreground="#CCC" FontSize="12" FontWeight="SemiBold"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="RegionList" Background="#252526" BorderThickness="0"
                             Foreground="#CCC" FontSize="11"
                             SelectionChanged="OnRegionSelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="StatusText" Text="Open a folder to get started" Foreground="#888888" FontSize="10"/>
        </Border>
    </Grid>
</Window>
