<Window x:Class="MTGProxyBuilder.UI.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="500" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseWheel="OnPreviewMouseWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP BAR ==================== -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10,7">
            <DockPanel>
                <!-- Right side: Print + Export PDF buttons -->
                <Button x:Name="ExportPdfBtn" DockPanel.Dock="Right" Content="Export PDF..."
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand"
                        Click="OnExportPdfClick">
                </Button>
                <Button x:Name="PrintBtn" DockPanel.Dock="Right" Content="Print..."
                        Background="#3E3E42" Foreground="#CCC" FontWeight="SemiBold"
                        BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,6,0"
                        Click="OnPrintClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}" x:Name="Bd">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#5E5E62"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Left side: Nav + Zoom -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Page navigation -->
                    <Button x:Name="PrevPageBtn" Content="&lt; Prev" Padding="8,4"
                            Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="OnPrevPageClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}" x:Name="Bd">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5E5E62"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Page" Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="PageNumberBox" Text="1" Width="36" Padding="4,3" FontSize="11"
                             Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1"
                             CaretBrush="White" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                             KeyDown="OnPageNumberKeyDown" LostFocus="OnPageNumberLostFocus"/>
                    <TextBlock x:Name="PageTotalLabel" Text="of 1" Foreground="#999" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBlock x:Name="PageSideLabel" Text="" Foreground="#CCC" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button x:Name="NextPageBtn" Content="Next &gt;" Padding="8,4"
                            Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="OnNextPageClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}" x:Name="Bd">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5E5E62"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="#555" Margin="12,3" VerticalAlignment="Stretch"/>

                    <!-- Zoom controls -->
                    <Button x:Name="FitBtn" Content="Fit" Padding="8,4"
                            Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="OnFitClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}" x:Name="Bd">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5E5E62"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ActualSizeBtn" Content="100%" Padding="8,4" Margin="4,0,0,0"
                            Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="OnActualSizeClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                        Padding="{TemplateBinding Padding}" x:Name="Bd">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4E4E52"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#5E5E62"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ZoomLabel" Text="100%"
                               Foreground="#CCC" FontSize="11" VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== CENTER: PAGE VIEWER ==================== -->
        <ScrollViewer Grid.Row="1" x:Name="PageScrollViewer"
                      Background="#1E1E1E"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MouseDown="OnScrollViewerMouseDown"
                      MouseMove="OnScrollViewerMouseMove"
                      MouseUp="OnScrollViewerMouseUp">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="20">
                <!-- White page background with drop shadow, scaled by zoom -->
                <Border Background="White" x:Name="PageBorder">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                    </Border.LayoutTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/>
                    </Border.Effect>
                    <Image x:Name="PageImage"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ==================== BUSY OVERLAY ==================== -->
        <Border Grid.Row="1" x:Name="BusyOverlay" Background="#CC1E1E1E" Visibility="Collapsed"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="BusyText" Text="Working..."
                           Foreground="White" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="BusyDetail" Text=""
                           Foreground="#AAA" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ==================== BOTTOM BAR ==================== -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10,5">
            <DockPanel>
                <TextBlock x:Name="InfoLabel" Text=""
                           Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
