<Window x:Class="MTGProxyBuilder.UI.Dialogs.MpcSourceManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MTGProxyBuilder.UI.Dialogs"
        Title="Manage MPCFill Sources" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="380" MinHeight="350"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Window.Resources>
        <local:FavStarConverter x:Key="FavStar"/>
        <local:FavBrushConverter x:Key="FavBrush"/>
        <local:FavActionConverter x:Key="FavAction"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="MPCFill Art Sources" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Foreground="#888" FontSize="11" Margin="0,24,0,8"
                   x:Name="CountLabel"/>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Padding="6,4" FontSize="12"
                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"
                     TextChanged="OnFilterChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <RadioButton x:Name="ShowAll" Content="All" Foreground="#CCC" FontSize="11" GroupName="Filter"
                             IsChecked="True" Checked="OnFilterChanged" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <RadioButton x:Name="ShowFavs" Content="Favorites" Foreground="#CCC" FontSize="11" GroupName="Filter"
                             Checked="OnFilterChanged" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Source list -->
        <ListBox Grid.Row="2" x:Name="SourceList" BorderThickness="1" BorderBrush="#444"
                 Background="#252526" Padding="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Favorite star -->
                        <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{Binding IsFavorite, Converter={StaticResource FavBrush}}"
                                   Text="{Binding IsFavorite, Converter={StaticResource FavStar}}"/>
                        <!-- Name + description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="#DDD" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" Foreground="#777" FontSize="9.5"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                        <!-- Toggle button -->
                        <Button Grid.Column="2" VerticalAlignment="Center" Padding="8,3" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" FontSize="10"
                                Foreground="{Binding IsFavorite, Converter={StaticResource FavBrush}}"
                                Content="{Binding IsFavorite, Converter={StaticResource FavAction}}"
                                Tag="{Binding Pk}" Click="OnToggleFavorite"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Summary -->
        <Border Grid.Row="3" Background="#252526" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
            <TextBlock x:Name="SummaryLabel" Foreground="#AAA" FontSize="11"/>
        </Border>

        <!-- Close -->
        <Button Grid.Row="4" Content="Close" Padding="14,7" Margin="0,12,0,0"
                Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                IsCancel="True" Click="OnClose"/>
    </Grid>


</Window>
