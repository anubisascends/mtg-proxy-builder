<Window x:Class="MTGProxyBuilder.UI.Dialogs.ArtSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Artwork" Height="620" Width="750"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="500" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleLabel" Text="Select Artwork" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CardNameLabel" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status / loading -->
        <Border Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusLabel" Text="Loading artwork options..." Foreground="#0078D4" FontSize="11"/>
                <TextBlock x:Name="SpinnerDot" Text="  ..." Foreground="#0078D4" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Options grid -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="OptionsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Preview of selected -->
        <Border Grid.Row="3" Margin="0,10,0,0" Height="60" Background="#252526" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="56" Background="#111" CornerRadius="3" Margin="0,0,10,0">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedLabel" Text="No selection" Foreground="#CCC" FontSize="12"/>
                    <TextBlock x:Name="SelectedDetailLabel" Foreground="#666" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: bulk action checkboxes -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <CheckBox x:Name="ApplySameNameChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed" Margin="0,0,0,2"/>
                <CheckBox x:Name="ApplyNoBackChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed"/>
            </StackPanel>

            <!-- Right: Cancel / Apply -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Padding="14,7"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="Apply" Padding="14,7"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OkClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
