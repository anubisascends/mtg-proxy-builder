<Window x:Class="MTGProxyBuilder.UI.Dialogs.ArtSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        Title="Select Artwork" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="#3E3E42" BorderThickness="0,0,0,2" x:Name="Bd">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock x:Name="TitleLabel" Text="Select Artwork" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CardNameLabel" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status / loading -->
        <Border Grid.Row="1" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusLabel" Text="Loading artwork options..." Foreground="#0078D4" FontSize="11"/>
                <TextBlock x:Name="SpinnerDot" Text="  ..." Foreground="#0078D4" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Main content: TabControl + shared preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="ArtTabControl" Grid.Column="0" Background="#1E1E1E" BorderThickness="0"
                        SelectionChanged="OnTabSelectionChanged" Margin="0,0,8,0">

                <!-- Front Art Tab -->
                <TabItem x:Name="FrontTabItem" Header="Front Art">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Actions bar (front mode) -->
                        <StackPanel Grid.Row="0" x:Name="FrontActionsBar" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                            <Button x:Name="ImportCacheBtn" Content="Import Downloaded Art" Padding="10,5" Margin="0,0,6,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnImportCacheToLibrary"/>
                            <Button x:Name="AddToLibraryBtn" Content="Add to Library..." Padding="10,5" Margin="0,0,6,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnAddToFrontLibraryClick"/>
                            <Button Content="Browse File..." Padding="10,5"
                                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnBrowseFileClick"/>
                        </StackPanel>

                        <!-- Filter bar (front) -->
                        <controls:PillFilterBar x:Name="FrontFilterBar" Grid.Row="1" Margin="0,0,0,6"/>

                        <!-- Front tiles -->
                        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="FrontOptionsPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Back Art Tab -->
                <TabItem x:Name="BackTabItem" Header="Back Art">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Actions bar (back mode) -->
                        <StackPanel Grid.Row="0" x:Name="BackActionsBar" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Download MPCFill Card Backs" Padding="10,5" Margin="0,0,6,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnDownloadMpcFillBacksClick"/>
                            <Button Content="Add to Library..." Padding="10,5" Margin="0,0,6,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnAddToBackLibraryClick"/>
                            <Button Content="Browse File..." Padding="10,5"
                                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    Click="OnBrowseFileClick"/>
                        </StackPanel>

                        <!-- Filter bar (back) -->
                        <controls:PillFilterBar x:Name="BackFilterBar" Grid.Row="1" Margin="0,0,0,6"/>

                        <!-- Back tiles -->
                        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="BackOptionsPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Shared preview panel -->
            <controls:ImagePreviewPanel x:Name="PreviewPanel" Grid.Column="1"/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                <CheckBox x:Name="ApplySameNameChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed" Margin="0,0,0,2"/>
                <CheckBox x:Name="ApplyNoBackChk" Foreground="#CCC" FontSize="11"
                          Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Padding="14,7"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="Apply" Padding="14,7"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OkClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
