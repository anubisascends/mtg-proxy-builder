<Window x:Class="MTGProxyBuilder.UI.Dialogs.ArtLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:converters="clr-namespace:MTGProxyBuilder.UI.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Art Library" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">

    <Window.Resources>
        <converters:ThumbnailConverter x:Key="ThumbConverter"/>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="#3E3E42" BorderThickness="0,0,0,2" x:Name="Bd">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared ListBox item style for both tabs -->
        <Style x:Key="LibraryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="100" Height="150" Margin="4"
                                Background="#3E3E42" CornerRadius="4" Cursor="Hand"
                                BorderThickness="2" BorderBrush="Transparent"
                                ToolTip="{Binding Name}">
                            <StackPanel>
                                <Border Height="115" Background="Black"
                                        CornerRadius="3,3,0,0" ClipToBounds="True">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource ThumbConverter}">
                                                <Binding Path="FilePath"/>
                                                <Binding Path="Id"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="#CCC"
                                           FontSize="9" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" Margin="3,4,3,0"/>
                                <TextBlock Text="{Binding Source}" Foreground="#888"
                                           FontSize="8" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" Margin="3,0,3,2"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="Art Library" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountLabel" Foreground="#888" FontSize="11" Margin="0,4,0,4"/>
        </StackPanel>

        <!-- Main content: TabControl + shared preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="LibraryTabControl" Grid.Column="0" Background="#1E1E1E" BorderThickness="0"
                        SelectionChanged="OnTabSelectionChanged" Margin="0,0,8,0">

                <!-- Front Art Tab -->
                <TabItem Header="Front Art">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Front actions bar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Add from File..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontAddFromFile"/>
                                <Button x:Name="FrontImportCacheBtn" Content="Import Downloaded Art" Padding="10,5" Margin="0,0,6,0"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontImportFromCache"/>
                                <Button Content="Remove Selected" Padding="10,5" Margin="0,0,6,0"
                                        Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontRemoveSelected" x:Name="FrontRemoveBtn" IsEnabled="False"/>
                                <Button Content="Regenerate Thumbnails" Padding="10,5"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontRegenerateThumbnails" x:Name="FrontRegenThumbBtn"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Move Library..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontMoveLibrary"/>
                                <Button Content="Export as ZIP..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontExportZip"/>
                                <Button Content="Import from ZIP..." Padding="10,5"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnFrontImportZip"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Front filter bar -->
                        <controls:PillFilterBar x:Name="FrontFilterBar" Grid.Row="1" Margin="0,0,0,6"/>

                        <!-- Front library grid -->
                        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="4">
                            <ListBox x:Name="FrontListBox" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnFrontSelectionChanged"
                                     MouseDoubleClick="OnFrontDoubleClick"
                                     ItemContainerStyle="{StaticResource LibraryItemStyle}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Back Art Tab -->
                <TabItem Header="Back Art">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Back actions bar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Add from File..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackAddFromFile"/>
                                <Button Content="Download MPCFill Card Backs" Padding="10,5" Margin="0,0,6,0"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackDownloadMpcFill" x:Name="BackDownloadBtn"/>
                                <Button Content="Set as Default" Padding="10,5" Margin="0,0,6,0"
                                        Background="Transparent" Foreground="#4CAF50" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackSetDefault" x:Name="BackDefaultBtn" IsEnabled="False"/>
                                <Button Content="Clear Default" Padding="10,5" Margin="0,0,6,0"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackClearDefault"/>
                                <Button Content="Remove Selected" Padding="10,5" Margin="0,0,6,0"
                                        Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackRemoveSelected" x:Name="BackRemoveBtn" IsEnabled="False"/>
                                <Button Content="Regenerate Thumbnails" Padding="10,5"
                                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackRegenerateThumbnails" x:Name="BackRegenThumbBtn"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Move Library..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackMoveLibrary"/>
                                <Button Content="Export as ZIP..." Padding="10,5" Margin="0,0,6,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackExportZip"/>
                                <Button Content="Import from ZIP..." Padding="10,5"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBackImportZip"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Back filter bar -->
                        <controls:PillFilterBar x:Name="BackFilterBar" Grid.Row="1" Margin="0,0,0,6"/>

                        <!-- Back library grid -->
                        <Border Grid.Row="2" Background="#252526" CornerRadius="4" Padding="4">
                            <ListBox x:Name="BackListBox" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnBackSelectionChanged"
                                     MouseDoubleClick="OnBackDoubleClick"
                                     ItemContainerStyle="{StaticResource LibraryItemStyle}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Shared preview panel -->
            <controls:ImagePreviewPanel x:Name="PreviewPanel" Grid.Column="1"/>
        </Grid>

        <!-- Status + Close -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsCancel="True" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
