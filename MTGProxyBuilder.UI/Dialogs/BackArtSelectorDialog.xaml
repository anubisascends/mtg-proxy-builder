<Window x:Class="MTGProxyBuilder.UI.Dialogs.BackArtSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Card Back" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select Card Back" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="CardNameLabel" Foreground="#888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Options grid -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="OptionsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Preview of selected -->
        <Border Grid.Row="2" Margin="0,10,0,0" Height="60" Background="#252526" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="56" Background="#111" CornerRadius="3" Margin="0,0,10,0">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedLabel" Text="No selection" Foreground="#CCC" FontSize="12"/>
                    <TextBlock x:Name="SelectedPath" Foreground="#666" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ClearBtn" Content="Clear Back Art" Padding="14,7"
                    Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand"
                    FontSize="12" Margin="0,0,8,0" Click="ClearClick"/>
            <Button Content="Cancel" Padding="14,7"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                    FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkBtn" Content="Apply" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OkClick" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
