<Window x:Class="MTGProxyBuilder.UI.Dialogs.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:vm="clr-namespace:MTGProxyBuilder.UI.ViewModels"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:converters="clr-namespace:MTGProxyBuilder.UI.Converters"
        Title="Card Editor"
        Width="1200" Height="800" MinWidth="800" MinHeight="500"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TAB BAR (Row 0) ==================== -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- New / Open buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,2">
                    <Button Style="{StaticResource ToolBtn}" Content="+ New" Padding="8,4" FontSize="11"
                            Click="OnNewTab"/>
                    <Button Style="{StaticResource ToolBtn}" Content="Open" Padding="8,4" FontSize="11"
                            Click="OnOpenTab"/>
                </StackPanel>

                <!-- Tab strip -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}" Margin="2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,5" Margin="1,2" CornerRadius="4,4,0,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnTabClick" Tag="{Binding}" x:Name="TabBd"
                                    Background="#3E3E42">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" Foreground="#DDD" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <Button Content="&#x2715;" Padding="4,0" Margin="6,0,0,0"
                                            Background="Transparent" Foreground="#888" BorderThickness="0"
                                            Cursor="Hand" FontSize="10" Click="OnTabClose" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static controls:ReferenceEqualsConverter.Instance}">
                                            <Binding/>
                                            <Binding Path="DataContext.ActiveTab"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="TabBd" Property="Background" Value="#1E1E1E"/>
                                    <Setter TargetName="TabBd" Property="BorderBrush" Value="#0078D4"/>
                                    <Setter TargetName="TabBd" Property="BorderThickness" Value="0,0,0,2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ==================== TOOLBAR (Row 1, per-tab) ==================== -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="6,4"
                BorderBrush="#333333" BorderThickness="0,0,0,1"
                DataContext="{Binding ActiveTab.Inner}"
                Visibility="{Binding DataContext.HasActiveTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
                <TextBlock Text="Name:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding Project.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="#3E3E42" Foreground="White" BorderBrush="#555555" BorderThickness="1"
                         CaretBrush="White" Padding="4,2" FontSize="11" MinWidth="140" VerticalAlignment="Center"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <Button Content="Save" Style="{StaticResource ToolBtn}" Command="{Binding SaveCommand}"
                        ToolTip="Save project (Ctrl+S)" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="Save As" Style="{StaticResource ToolBtn}" Command="{Binding SaveAsCommand}"
                        ToolTip="Save project as..." Padding="8,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <Button Content="Export PNG" Style="{StaticResource AccentBtn}" Command="{Binding ExportImageCommand}"
                        ToolTip="Export as image" Padding="10,4" Margin="0,0,2,0" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <Button Content="+ Image" Style="{StaticResource ToolBtn}" Command="{Binding AddImageLayerCommand}"
                        ToolTip="Add image layer" Padding="8,4" Margin="0,0,2,0" FontSize="11"/>
                <Button Content="+ Text" Style="{StaticResource ToolBtn}" Command="{Binding AddTextLayerCommand}"
                        ToolTip="Add text layer" Padding="8,4" FontSize="11"/>

                <Rectangle Width="1" Fill="#555555" Margin="6,2"/>

                <TextBlock VerticalAlignment="Center" Foreground="#888888" FontSize="10" Margin="4,0">
                    <Run Text="{Binding Project.CardWidthPx, Mode=OneWay}"/>
                    <Run Text="x"/>
                    <Run Text="{Binding Project.CardHeightPx, Mode=OneWay}"/>
                    <Run Text="px"/>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- ==================== WELCOME SCREEN (no tab open) ==================== -->
        <Border Grid.Row="2" Background="#1E1E1E"
                Visibility="{Binding HasActiveTab, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Card Editor" Foreground="#555" FontSize="36" FontWeight="Light"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Create or open a project to get started" Foreground="#444" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,8,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AccentBtn}" Content="New Card" Padding="16,8"
                            FontSize="13" Margin="0,0,10,0" Click="OnNewTab"/>
                    <Button Style="{StaticResource ToolBtn}" Content="Open Project" Padding="16,8"
                            FontSize="13" Background="#3E3E42" Click="OnOpenTab"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN AREA with AvalonDock (Row 2) ==================== -->
        <Grid Grid.Row="2" DataContext="{Binding ActiveTab.Inner}"
              Visibility="{Binding DataContext.HasActiveTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

            <avalonDock:DockingManager x:Name="DockManager" Background="#1E1E1E">
                <avalonDock:DockingManager.Theme>
                    <avalonTheme:Vs2013DarkTheme/>
                </avalonDock:DockingManager.Theme>
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!-- LEFT: Layers panel -->
                        <avalonDock:LayoutAnchorablePane DockWidth="220">
                            <avalonDock:LayoutAnchorable Title="Layers" ContentId="LayersPanel"
                                                         CanClose="False" CanHide="True" AutoHideWidth="220">
                                <controls:LayerListPanel x:Name="LayerPanel" DataContext="{Binding}"
                                    controls:LayerListPanel.AddImageLayerRequested="OnAddImageLayer"
                                    controls:LayerListPanel.AddTextLayerRequested="OnAddTextLayer"
                                    controls:LayerListPanel.DeleteLayerRequested="OnDeleteLayer"
                                    controls:LayerListPanel.MoveUpRequested="OnMoveUp"
                                    controls:LayerListPanel.MoveDownRequested="OnMoveDown"/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!-- CENTER: Canvas document -->
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="Canvas" ContentId="CanvasDocument" CanClose="False">
                                <controls:CardEditorCanvas x:Name="EditorCanvas"
                                    Project="{Binding Project}"
                                    SelectedLayer="{Binding SelectedLayer, Mode=TwoWay}"
                                    RefreshTrigger="{Binding RefreshTrigger}"/>
                            </avalonDock:LayoutDocument>
                        </avalonDock:LayoutDocumentPane>

                        <!-- RIGHT: Properties panel -->
                        <avalonDock:LayoutAnchorablePane DockWidth="280">
                            <avalonDock:LayoutAnchorable Title="Properties" ContentId="PropertiesPanel"
                                                         CanClose="False" CanHide="True" AutoHideWidth="280">
                                <controls:PropertyPanel x:Name="PropPanel" DataContext="{Binding}"
                                    controls:PropertyPanel.BrowseImageRequested="OnBrowseImage"/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <!-- ==================== STATUS BAR (Row 3) ==================== -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#888888" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" Foreground="#666666" FontSize="10"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasActiveTab, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Layers:"/>
                    <Run Text="{Binding ActiveTab.Inner.Layers.Count, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
