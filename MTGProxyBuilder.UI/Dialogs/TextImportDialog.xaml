<Window x:Class="MTGProxyBuilder.UI.Dialogs.TextImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Card List" Height="520" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="400" MinHeight="350"
        Background="#1E1E1E" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Import Card List" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Foreground="#888" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap">
                Enter one card per line. Format: [qty] [name] ([set]) [number]
                <LineBreak/>
                Examples: 4 Lightning Bolt (3ED) 152 &#x2022; 2 Counterspell (MH2) &#x2022; Sol Ring
            </TextBlock>
        </StackPanel>

        <!-- Text input -->
        <TextBox x:Name="CardListBox" Grid.Row="1"
                 AcceptsReturn="True" AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 Background="#2D2D30" Foreground="White" BorderBrush="#555"
                 CaretBrush="White" Padding="8,6"/>

        <!-- Status -->
        <TextBlock x:Name="StatusLabel" Grid.Row="2" Foreground="#0078D4" FontSize="11" Margin="0,8,0,0"/>

        <!-- Not found panel (hidden by default) -->
        <Border x:Name="NotFoundPanel" Grid.Row="3" Background="#3E3E42" CornerRadius="4" Padding="8,6"
                Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NotFoundLabel" Foreground="#E06060" FontSize="11" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Copy Names" Padding="8,3" FontSize="10"
                            Background="#555" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                            Click="OnCopyNotFound"/>
                </Grid>
                <TextBox x:Name="NotFoundList" IsReadOnly="True" MaxHeight="100"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="10"
                         Background="#2D2D30" Foreground="#AAA" BorderThickness="0"
                         Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0"
                    Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                    Click="OnCancel"/>
            <Button x:Name="ImportBtn" Content="Import" Padding="16,6"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="OnImport"/>
        </StackPanel>
    </Grid>
</Window>
