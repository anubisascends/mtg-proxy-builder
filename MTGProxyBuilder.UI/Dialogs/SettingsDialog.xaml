<Window x:Class="MTGProxyBuilder.UI.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="620" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="600" MinHeight="450"
        Background="#1E1E1E" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Section card style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Hint text style -->
        <Style x:Key="HintLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Nav button style -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left nav -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#252526" Padding="8,16">
            <StackPanel>
                <TextBlock Text="Settings" Foreground="White" FontSize="16" FontWeight="Bold" Margin="8,0,0,16"/>
                <RadioButton x:Name="NavGeneral" Content="General" Style="{StaticResource NavButton}" IsChecked="True"
                             Checked="OnNavChanged"/>
                <RadioButton x:Name="NavLibraries" Content="Art Libraries" Style="{StaticResource NavButton}"
                             Checked="OnNavChanged"/>
                <RadioButton x:Name="NavMpcFill" Content="MPCFill" Style="{StaticResource NavButton}"
                             Checked="OnNavChanged"/>
                <RadioButton x:Name="NavLanguages" Content="Languages" Style="{StaticResource NavButton}"
                             Checked="OnNavChanged"/>
                <RadioButton x:Name="NavFilters" Content="Content Filters" Style="{StaticResource NavButton}"
                             Checked="OnNavChanged"/>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
            <Grid>
                <!-- ==================== GENERAL ==================== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Text="General" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="New Project Defaults" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Page Size" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="PagePresetBox" Padding="4" FontSize="11">
                                        <ComboBoxItem>A1</ComboBoxItem>
                                        <ComboBoxItem>A2</ComboBoxItem>
                                        <ComboBoxItem>A3</ComboBoxItem>
                                        <ComboBoxItem>A4</ComboBoxItem>
                                        <ComboBoxItem>Letter</ComboBoxItem>
                                        <ComboBoxItem>Legal</ComboBoxItem>
                                        <ComboBoxItem>Tabloid</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bleed Width (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BleedBox" Padding="6,4" FontSize="12" Width="80" HorizontalAlignment="Left"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Token Overlay Text" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TokenTextBox" Padding="6,4" FontSize="12" Width="200" HorizontalAlignment="Left"
                                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                            <TextBlock Text="Text displayed on token cards (e.g. TOKEN)" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Application" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="UpdateCheckBox" Content="Check for updates on startup"
                                      Foreground="#CCC" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="UI" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Sidebar Font Size" Foreground="#999" FontSize="10" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FontSizeSlider" Minimum="9" Maximum="18" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="12"
                                        ValueChanged="OnFontSizeSliderChanged"/>
                                <TextBlock Grid.Column="1" x:Name="FontSizeLabel" Text="12 pt" Foreground="#CCC"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40"/>
                            </Grid>
                            <TextBlock Text="Adjust the text size in the sidebar panels" Foreground="#666" FontSize="9" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== ART LIBRARIES ==================== -->
                <StackPanel x:Name="PageLibraries" Visibility="Collapsed">
                    <TextBlock Text="Art Libraries" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Front Art Library" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FrontLibPathBox" Padding="6,4" FontSize="11" IsReadOnly="True"
                                         Background="#3E3E42" Foreground="#AAA" BorderBrush="#555"/>
                                <Button Grid.Column="1" Content="Browse..." Padding="10,4" Margin="6,0,0,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBrowseFrontLibPath"/>
                                <Button Grid.Column="2" Content="Reset" Padding="10,4" Margin="4,0,0,0"
                                        Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnResetFrontLibPath"/>
                            </Grid>
                            <TextBlock Text="Browse for an existing catalog.json to use a library at a custom location"
                                       Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Back Art Library" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackLibPathBox" Padding="6,4" FontSize="11" IsReadOnly="True"
                                         Background="#3E3E42" Foreground="#AAA" BorderBrush="#555"/>
                                <Button Grid.Column="1" Content="Browse..." Padding="10,4" Margin="6,0,0,0"
                                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnBrowseBackLibPath"/>
                                <Button Grid.Column="2" Content="Reset" Padding="10,4" Margin="4,0,0,0"
                                        Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" FontSize="11"
                                        Click="OnResetBackLibPath"/>
                            </Grid>
                            <TextBlock Text="Browse for an existing catalog.json to use a library at a custom location"
                                       Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Background="#2A2A2A">
                        <StackPanel>
                            <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap">
                                Changes to library locations take effect on the next app restart.
                                You can also move libraries from within the library dialogs.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== MPCFILL ==================== -->
                <StackPanel x:Name="PageMpcFill" Visibility="Collapsed">
                    <TextBlock Text="MPCFill" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Sources" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="UseFavoritesCheckBox" Content="Only use favorite sources"
                                      Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock x:Name="FavoritesInfoLabel" Foreground="#888" FontSize="10" Margin="0,0,0,10"/>
                            <Button x:Name="ManageSourcesBtn" Content="Manage Sources..." Padding="12,6"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                                    HorizontalAlignment="Left" Click="OnManageSources"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Search Defaults" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sort Order" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="SortByBox" Padding="4" FontSize="11">
                                        <ComboBoxItem Tag="nameAscending" Content="Name A-Z"/>
                                        <ComboBoxItem Tag="nameDescending" Content="Name Z-A"/>
                                        <ComboBoxItem Tag="dateCreatedDescending" Content="Newest First"/>
                                        <ComboBoxItem Tag="dateCreatedAscending" Content="Oldest First"/>
                                        <ComboBoxItem Tag="dateModifiedDescending" Content="Recently Modified"/>
                                        <ComboBoxItem Tag="dateModifiedAscending" Content="Least Recently Modified"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max File Size (MB)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MaxSizeBox" Padding="6,4" FontSize="12" Width="80" HorizontalAlignment="Left"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Min DPI" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="DefaultMinDpiBox" Padding="4" FontSize="11">
                                        <ComboBoxItem Tag="0" Content="0 (Any)"/>
                                        <ComboBoxItem Tag="300" Content="300"/>
                                        <ComboBoxItem Tag="600" Content="600"/>
                                        <ComboBoxItem Tag="800" Content="800"/>
                                        <ComboBoxItem Tag="1200" Content="1200"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max DPI" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="DefaultMaxDpiBox" Padding="4" FontSize="11">
                                        <ComboBoxItem Tag="300" Content="300"/>
                                        <ComboBoxItem Tag="600" Content="600"/>
                                        <ComboBoxItem Tag="800" Content="800"/>
                                        <ComboBoxItem Tag="1200" Content="1200"/>
                                        <ComboBoxItem Tag="1500" Content="1500"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="DefaultFuzzySearchBox" Content="Fuzzy search by default"
                                      Foreground="#CCC" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox x:Name="FilterCardbacksBox" Content="Filter out cardbacks from search results"
                                      Foreground="#CCC" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Card Types" Style="{StaticResource SectionHeader}"/>
                            <WrapPanel>
                                <CheckBox x:Name="CardTypeCard" Content="Cards" Foreground="#CCC" FontSize="11" Margin="0,0,18,0"/>
                                <CheckBox x:Name="CardTypeToken" Content="Tokens" Foreground="#CCC" FontSize="11" Margin="0,0,18,0"/>
                                <CheckBox x:Name="CardTypeCardback" Content="Card Backs" Foreground="#CCC" FontSize="11"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== LANGUAGES ==================== -->
                <StackPanel x:Name="PageLanguages" Visibility="Collapsed">
                    <TextBlock Text="Languages" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="MPCFill Language Filter" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Leave all unchecked to include all languages in search results"
                                       Style="{StaticResource HintLabel}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <CheckBox x:Name="LangEN" Content="English"    Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangJA" Content="Japanese"   Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangFR" Content="French"     Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangDE" Content="German"     Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangES" Content="Spanish"    Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangIT" Content="Italian"    Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangPT" Content="Portuguese" Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangZH" Content="Chinese"    Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangRU" Content="Russian"    Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangAR" Content="Arabic"     Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                                <CheckBox x:Name="LangSA" Content="Sanskrit"   Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== CONTENT FILTERS ==================== -->
                <StackPanel x:Name="PageFilters" Visibility="Collapsed">
                    <TextBlock Text="Content Filters" Style="{StaticResource SectionHeader}" FontSize="18" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="MPCFill Content Exclusions" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Filter out specific types of content from MPCFill search results"
                                       Style="{StaticResource HintLabel}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ExcludeNsfwBox" Content="Exclude NSFW content"
                                      Foreground="#CCC" FontSize="11" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ExcludeAiArtBox" Content="Exclude AI-generated art"
                                      Foreground="#CCC" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,8"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Padding="16,8"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="12" FontWeight="SemiBold" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
