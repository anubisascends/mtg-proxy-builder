<Window x:Class="MTGProxyBuilder.UI.Dialogs.FrontArtLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:converters="clr-namespace:MTGProxyBuilder.UI.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Front Art Library" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="650" MinHeight="400"
        Background="#1E1E1E" ShowInTaskbar="False">

    <Window.Resources>
        <converters:ThumbnailConverter x:Key="ThumbConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Front Art Library" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" x:Name="CountLabel" Foreground="#888" FontSize="11" Margin="0,24,0,8"/>

        <!-- Actions bar -->
        <StackPanel Grid.Row="1" Margin="0,4,0,6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Add from File..." Padding="10,5" Margin="0,0,6,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnAddFromFile"/>
                <Button x:Name="ImportCacheBtn" Content="Import Downloaded Art" Padding="10,5" Margin="0,0,6,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnImportFromCache"/>
                <Button Content="Remove Selected" Padding="10,5" Margin="0,0,6,0"
                        Background="Transparent" Foreground="#E06060" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnRemoveSelected" x:Name="RemoveBtn" IsEnabled="False"/>
                <Button Content="Regenerate Thumbnails" Padding="10,5"
                        Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnRegenerateThumbnails" x:Name="RegenThumbBtn"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Move Library..." Padding="10,5" Margin="0,0,6,0"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnMoveLibrary"/>
                <Button Content="Export as ZIP..." Padding="10,5" Margin="0,0,6,0"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnExportZip"/>
                <Button Content="Import from ZIP..." Padding="10,5"
                        Background="#3E3E42" Foreground="#CCC" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Click="OnImportZip"/>
            </StackPanel>
        </StackPanel>

        <!-- Filter bar -->
        <controls:PillFilterBar x:Name="FilterBar" Grid.Row="2" Margin="0,0,0,6"/>

        <!-- Main content: Virtualized grid + Preview -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                <ListBox x:Name="LibraryListBox" Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended"
                         SelectionChanged="OnListBoxSelectionChanged"
                         MouseDoubleClick="OnListBoxDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Width="100" Height="150" Margin="4"
                                                Background="#3E3E42" CornerRadius="4" Cursor="Hand"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                ToolTip="{Binding Name}">
                                            <StackPanel>
                                                <Border Height="115" Background="Black"
                                                        CornerRadius="3,3,0,0" ClipToBounds="True">
                                                    <Image Stretch="UniformToFill">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource ThumbConverter}">
                                                                <Binding Path="FilePath"/>
                                                                <Binding Path="Id"/>
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="#CCC"
                                                           FontSize="9" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" Margin="3,4,3,0"/>
                                                <TextBlock Text="{Binding Source}" Foreground="#888"
                                                           FontSize="8" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" Margin="3,0,3,2"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <controls:ImagePreviewPanel x:Name="PreviewPanel" Grid.Column="1"/>
        </Grid>

        <!-- Status + Close -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Padding="14,7"
                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"
                    FontSize="12" FontWeight="SemiBold" IsCancel="True" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
