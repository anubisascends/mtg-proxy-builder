<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MTGProxyBuilder.Core\MTGProxyBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
<PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>tcg-proxy-builder</AssemblyName>
    <Product>TCG Proxy Builder</Product>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

</Project>
