<UserControl x:Class="MTGProxyBuilder.UI.Controls.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MTGProxyBuilder.Core.Models;assembly=MTGProxyBuilder.Core"
             xmlns:local="clr-namespace:MTGProxyBuilder.UI.Controls">

    <UserControl.Resources>
        <local:LayerTypeConverter x:Key="LayerTypeConv"/>
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="#252526">
        <StackPanel Margin="8" x:Name="PropertiesRoot">
            <!-- No selection message -->
            <TextBlock x:Name="NoSelectionText" Text="No layer selected"
                       Foreground="#666666" FontSize="11" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <!-- Properties (visible when a layer is selected) -->
            <StackPanel x:Name="PropertiesPanel" Visibility="Collapsed">

                <!-- Layer Name -->
                <TextBlock Text="LAYER" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Name" Style="{StaticResource PropLabel}"/>
                <TextBox Style="{StaticResource PropTextBox}"
                         Text="{Binding SelectedLayer.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Position -->
                <TextBlock Text="POSITION" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource PropLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Style="{StaticResource PropLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.X, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.Y, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                </Grid>

                <!-- Size -->
                <TextBlock Text="SIZE" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="W" Style="{StaticResource PropLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="H" Style="{StaticResource PropLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
                </Grid>

                <!-- Transform -->
                <TextBlock Text="TRANSFORM" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Rotation" Style="{StaticResource PropLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="360" Value="{Binding SelectedLayer.Rotation, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="10"
                               HorizontalAlignment="Right"
                               Text="{Binding SelectedLayer.Rotation, StringFormat={}{0:F0}deg}"/>
                </Grid>

                <TextBlock Text="Opacity" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="1" Value="{Binding SelectedLayer.Opacity, Mode=TwoWay}"
                            LargeChange="0.1" SmallChange="0.01" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="10"
                               HorizontalAlignment="Right"
                               Text="{Binding SelectedLayer.Opacity, StringFormat={}{0:P0}}"/>
                </Grid>

                <!-- Image Layer Properties -->
                <StackPanel x:Name="ImageProperties" Visibility="Collapsed">
                    <TextBlock Text="IMAGE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Source" Style="{StaticResource PropLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Background="#3E3E42" Foreground="White" Padding="4,2"
                                   FontSize="11" VerticalAlignment="Center"
                                   Text="{Binding SelectedLayer.ImageSource, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolBtn}"
                                Padding="8,2" Margin="4,0,0,0" FontSize="11"
                                Click="BrowseImage_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Text Layer Properties -->
                <StackPanel x:Name="TextProperties" Visibility="Collapsed">
                    <TextBlock Text="TEXT" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Content" Style="{StaticResource PropLabel}"/>
                    <TextBox Style="{StaticResource PropTextBox}" AcceptsReturn="True" MinHeight="60"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedLayer.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Font" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                    <ComboBox x:Name="FontComboBox"
                              SelectedItem="{Binding SelectedLayer.FontFamily, Mode=TwoWay}"
                              MaxDropDownHeight="300"/>

                    <TextBlock Text="Size" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                    <TextBox Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Text="Color" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource PropTextBox}" x:Name="FontColorBox"
                                 Text="{Binding SelectedLayer.FontColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1" x:Name="FontColorSwatch" Width="28" Height="24"
                                Margin="4,0,0,0" Cursor="Hand" BorderThickness="1"
                                BorderBrush="#555555" Click="OnPickFontColor"
                                ToolTip="Pick color"/>
                    </Grid>

                    <TextBlock Text="Stroke Color" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource PropTextBox}" x:Name="StrokeColorBox"
                                 Text="{Binding SelectedLayer.StrokeColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Button Grid.Column="1" x:Name="StrokeColorSwatch" Width="28" Height="24"
                                Margin="4,0,0,0" Cursor="Hand" BorderThickness="1"
                                BorderBrush="#555555" Click="OnPickStrokeColor"
                                ToolTip="Pick color"/>
                    </Grid>

                    <!-- Style toggles -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton Content="B" Width="28" Height="24" FontWeight="Bold"
                                      IsChecked="{Binding SelectedLayer.IsBold, Mode=TwoWay}"
                                      Style="{StaticResource ToolBtn}" Margin="0,0,2,0"/>
                        <ToggleButton Content="I" Width="28" Height="24" FontStyle="Italic"
                                      IsChecked="{Binding SelectedLayer.IsItalic, Mode=TwoWay}"
                                      Style="{StaticResource ToolBtn}" Margin="0,0,8,0"/>
                        <Rectangle Width="1" Fill="#555555" Margin="0,2,8,2"/>
                        <RadioButton Content="L" GroupName="TextAlign" Width="28" Height="24"
                                     Style="{StaticResource ToolBtn}"
                                     IsChecked="{Binding SelectedLayer.TextAlignment, Converter={StaticResource LayerTypeConv}, ConverterParameter=Left}"
                                     Margin="0,0,2,0"/>
                        <RadioButton Content="C" GroupName="TextAlign" Width="28" Height="24"
                                     Style="{StaticResource ToolBtn}"
                                     IsChecked="{Binding SelectedLayer.TextAlignment, Converter={StaticResource LayerTypeConv}, ConverterParameter=Center}"
                                     Margin="0,0,2,0"/>
                        <RadioButton Content="R" GroupName="TextAlign" Width="28" Height="24"
                                     Style="{StaticResource ToolBtn}"
                                     IsChecked="{Binding SelectedLayer.TextAlignment, Converter={StaticResource LayerTypeConv}, ConverterParameter=Right}"/>
                    </StackPanel>

                    <TextBlock Text="Stroke Width" Style="{StaticResource PropLabel}" Margin="0,6,0,2"/>
                    <TextBox Style="{StaticResource PropTextBox}"
                             Text="{Binding SelectedLayer.StrokeWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
