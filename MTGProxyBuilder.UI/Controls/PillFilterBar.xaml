<UserControl x:Class="MTGProxyBuilder.UI.Controls.PillFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2D2D30" BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="4,2">
        <Grid>
            <WrapPanel x:Name="PillContainer" Orientation="Horizontal">
                <!-- Pills are inserted before the InputBox programmatically -->
                <TextBox x:Name="InputBox"
                         MinWidth="120" Width="Auto"
                         Padding="4,2" Margin="2"
                         FontSize="12"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         KeyDown="OnInputKeyDown"
                         TextChanged="OnInputTextChanged"
                         PreviewKeyDown="OnInputPreviewKeyDown"/>
            </WrapPanel>

            <!-- Placeholder text shown when no pills and no text -->
            <TextBlock x:Name="PlaceholderText"
                       Text="Click to see available filters..."
                       Foreground="#666" FontSize="12"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"/>

            <!-- Autocomplete popup -->
            <Popup x:Name="AutocompletePopup"
                   PlacementTarget="{Binding ElementName=InputBox}"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <Border Background="#2D2D30" BorderBrush="#555" BorderThickness="1"
                        CornerRadius="4" Padding="2">
                    <ListBox x:Name="SuggestionList"
                             MaxHeight="240"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#CCC"
                             FontSize="12"
                             PreviewMouseLeftButtonDown="OnSuggestionMouseDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Foreground" Value="#CCC"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E42"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
