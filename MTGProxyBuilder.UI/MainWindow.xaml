<Window x:Class="MTGProxyBuilder.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MTGProxyBuilder.UI.Controls"
        xmlns:converters="clr-namespace:MTGProxyBuilder.UI.Converters"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        mc:Ignorable="d"
        Title="MTG Proxy Builder"
        Height="950" Width="1600" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <DropShadowEffect x:Key="PageShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.35"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed"/>

        <!-- Tab style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="#3E3E42" BorderThickness="0,0,0,2" x:Name="Bd">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== PROJECT TAB BAR ==================== -->
        <Border Grid.Row="0" Background="#252526">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Global file actions (always available) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,2">
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding NewProjectCommand}" Content="+ New" Padding="8,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenProjectCommand}" Content="Open" Padding="8,4"/>
                    <Border Width="1" Background="#444" Margin="4,4"/>
                </StackPanel>

                <!-- Project tabs -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,5" Margin="1,2" CornerRadius="4,4,0,0" Cursor="Hand"
                                    MouseLeftButtonUp="OnTabClick" Tag="{Binding}"
                                    Background="#3E3E42">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TabTitle}" Foreground="#DDD" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="&#x2715;" Padding="4,0" Margin="6,0,0,0"
                                            Background="Transparent" Foreground="#888" BorderThickness="0"
                                            Cursor="Hand" FontSize="9" VerticalAlignment="Center"
                                            Click="OnTabClose" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Global right buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,2">
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenCardEditorCommand}" Content="Card Editor" Padding="8,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenFrameMapperCommand}" Content="Frame Mapper" Padding="8,4"/>
                    <Rectangle Width="1" Fill="#555555" Margin="2,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ManageFrontArtLibraryCommand}" Content="Front Art Library" Padding="8,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ManageBackArtLibraryCommand}" Content="Back Art Library" Padding="8,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenSettingsCommand}" Content="Settings" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== TOP TOOLBAR (per-project, binds through ActiveProject.Inner) ==================== -->
        <Border x:Name="TabBarRoot" Grid.Row="1" Background="#2D2D30" Padding="6,4"
                DataContext="{Binding ActiveProject.Inner}"
                Visibility="{Binding DataContext.HasActiveProject, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Project actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding SaveProjectCommand}" Content="Save"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding UndoCommand}" Content="Undo" ToolTip="Ctrl+Z"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding RedoCommand}" Content="Redo" ToolTip="Ctrl+Y"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding AddCardFromFileCommand}" Content="+ File"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding RemoveCardCommand}" Content="- Card"/>
                    <Border Width="1" Background="#444" Margin="6,4"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ClearAllCardsCommand}" Content="Clear All" Foreground="#E06060"/>
                </StackPanel>

                <!-- Project name -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Project:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Padding="6,4" FontSize="12"
                             Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1"
                             CaretBrush="White"/>
                </StackPanel>

                <Border Grid.Column="2"/>

                <Button Grid.Column="3" Style="{StaticResource AccentBtn}" Command="{Binding ExportPdfCommand}" Content="Export PDF" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- ==================== UPDATE BANNER ==================== -->
        <Border Grid.Row="2" Background="#4A3800" Padding="10,6"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x26A0;" Foreground="#FFB800" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding UpdateMessage}" Foreground="#FFD" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Download" Padding="10,4" Margin="8,0"
                        Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11"
                        Command="{Binding DownloadUpdateCommand}"/>
                <Button Grid.Column="3" Content="&#x2715;" Padding="6,2"
                        Background="Transparent" Foreground="#AA9" BorderThickness="0" Cursor="Hand" FontSize="12"
                        Command="{Binding DismissUpdateCommand}" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <!-- ==================== WELCOME SCREEN (no project open) ==================== -->
        <Border Grid.Row="3" Background="#1E1E1E"
                Visibility="{Binding HasActiveProject, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="TCG Proxy Builder" Foreground="#555" FontSize="36" FontWeight="Light" HorizontalAlignment="Center"/>
                <TextBlock Text="Create or open a project to get started" Foreground="#444" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AccentBtn}" Command="{Binding NewProjectCommand}" Content="New Project" Padding="16,8" FontSize="13" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource ToolBtn}" Command="{Binding OpenProjectCommand}" Content="Open Project" Padding="16,8" FontSize="13"
                            Background="#3E3E42"/>
                </StackPanel>
                <TextBlock Foreground="#444" FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Run Text="v"/><Run Text="{Binding AppVersion, Mode=OneTime}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN AREA (project content) ==================== -->
        <Grid Grid.Row="3" DataContext="{Binding ActiveProject.Inner}"
              Visibility="{Binding DataContext.HasActiveProject, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

            <avalonDock:DockingManager x:Name="DockManager" Background="#1E1E1E">
                <avalonDock:DockingManager.Theme>
                    <avalonTheme:Vs2013DarkTheme/>
                </avalonDock:DockingManager.Theme>
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!-- CENTER: Canvas document -->
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument Title="Page Preview" ContentId="PagePreview" CanClose="False">
                                <Border Background="#252526">
                <Grid>
                    <ScrollViewer x:Name="CanvasScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#1E1E1E"
                                  PreviewMouseWheel="OnCanvasMouseWheel"
                                  PreviewMouseDown="OnCanvasMouseDown"
                                  PreviewMouseUp="OnCanvasMouseUp"
                                  PreviewMouseMove="OnCanvasMouseMove">
                        <Border Padding="30" HorizontalAlignment="Center">
                            <Border Effect="{StaticResource PageShadow}">
                                <controls:GridEditorCanvas x:Name="GridCanvas"
                                    PageSettings="{Binding CurrentProject.PageSettings}"
                                    CardsSource="{Binding Cards}"
                                    ShowCutGuides="{Binding CurrentProject.PrintSettings.ShowCutGuides}"
                                    PrintSettingsSource="{Binding CurrentProject.PrintSettings}"
                                    SelectedCard="{Binding SelectedCard}"
                                    UndoSvc="{Binding UndoServiceInstance}"
                                    RefreshTrigger="{Binding RefreshTrigger}"
                                    Cursor="Hand">
                                    <controls:GridEditorCanvas.LayoutTransform>
                                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                    </controls:GridEditorCanvas.LayoutTransform>
                                </controls:GridEditorCanvas>
                            </Border>
                        </Border>
                    </ScrollViewer>

                    <!-- Render progress overlay -->
                    <Border Background="#CC1E1E1E" CornerRadius="6" Padding="16,10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsRendering, ElementName=GridCanvas, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RenderProgress, ElementName=GridCanvas}" FontSize="12"
                                       Foreground="#0078D4" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Zoom indicator -->
                    <Border Background="#CC2D2D30" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="-" Padding="6,1" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                    Click="ZoomOut"/>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#CCC" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0" MinWidth="36" TextAlignment="Center"/>
                            <Button Content="+" Padding="6,1" FontSize="14" FontWeight="Bold"
                                    Background="Transparent" Foreground="#CCC" BorderThickness="0" Cursor="Hand"
                                    Click="ZoomIn"/>
                            <Border Width="1" Background="#555" Margin="6,2"/>
                            <Button Content="Fit" Padding="6,1" FontSize="11"
                                    Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                    Click="ZoomFit"/>
                            <Button Content="1:1" Padding="6,1" FontSize="11"
                                    Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                    Click="ZoomReset"/>
                        </StackPanel>
                    </Border>
                                </Grid>
                            </Border>
                        </avalonDock:LayoutDocument>
                    </avalonDock:LayoutDocumentPane>

                    <!-- RIGHT: Tool panels as dockable anchorables -->
                    <avalonDock:LayoutAnchorablePane DockWidth="300">

                        <!-- ===== SEARCH PANEL ===== -->
                        <avalonDock:LayoutAnchorable Title="Search" ContentId="SearchPanel" CanClose="False" CanHide="True" AutoHideWidth="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                                <StackPanel Margin="10,8">
                                <!-- Search box -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ScryfallSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,5" FontSize="12"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1"
                                             CaretBrush="White" x:Name="ScryfallSearchBox"/>
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}"
                                            Command="{Binding ScryfallSearchCommand}" Content="Search" Margin="4,0,0,0" Padding="10,5"/>
                                </Grid>

                                <!-- Scryfall advanced search toggle -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox IsChecked="{Binding ShowAdvancedSearch}" Foreground="#AAA" FontSize="10" Content="Advanced Search"
                                              VerticalContentAlignment="Center"/>
                                    <TextBlock Text="  Scryfall syntax" Foreground="#555" FontSize="9" VerticalAlignment="Center"
                                               Visibility="{Binding ShowAdvancedSearch, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <!-- Advanced search panel (Scryfall only) -->
                                <Border Background="#252526" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAdvancedSearch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Name" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                        <TextBox Text="{Binding AdvName, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>

                                        <TextBlock Text="Type (e.g. creature, instant, legendary)" Foreground="#999" FontSize="9.5" Margin="0,4,0,1"/>
                                        <TextBox Text="{Binding AdvType, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>

                                        <TextBlock Text="Rules text contains" Foreground="#999" FontSize="9.5" Margin="0,4,0,1"/>
                                        <TextBox Text="{Binding AdvOracle, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Colors (WUBRG)" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding AdvColors, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Identity (WUBRG)" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding AdvIdentity, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                                                <TextBlock Text="Mana Value" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding ComparisonOps}" SelectedItem="{Binding AdvCmcOp}" Padding="2" FontSize="10"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AdvCmcValue, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Grid.ColumnSpan="2">
                                                <TextBlock Text="Rarity" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <ComboBox ItemsSource="{Binding RarityAdvOptions}" SelectedItem="{Binding AdvRarity}" Padding="2" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Power" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding ComparisonOps}" SelectedItem="{Binding AdvPowOp}" Padding="2" FontSize="10"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AdvPowValue, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Toughness" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding ComparisonOps}" SelectedItem="{Binding AdvTouOp}" Padding="2" FontSize="10"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AdvTouValue, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Set code" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding AdvSet, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Format" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding AdvFormat}" Padding="2" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Artist" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding AdvArtist, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Keyword" Foreground="#999" FontSize="9.5" Margin="0,0,0,1"/>
                                                <TextBox Text="{Binding AdvKeyword, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11"
                                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Card is..." Foreground="#999" FontSize="9.5" Margin="0,4,0,1"/>
                                        <ComboBox ItemsSource="{Binding IsOptions}" SelectedItem="{Binding AdvIs}" Padding="2" FontSize="10" Margin="0,0,0,6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource AccentBtn}"
                                                    Command="{Binding BuildAdvancedQueryCommand}" Content="Build &amp; Search" Padding="6,5"/>
                                            <Button Grid.Column="2" Style="{StaticResource ToolBtn}"
                                                    Command="{Binding ClearAdvancedSearchCommand}" Content="Clear" Padding="6,5"/>
                                        </Grid>

                                        <TextBlock Text="Query:" Foreground="#666" FontSize="9" Margin="0,6,0,1"/>
                                        <TextBlock Text="{Binding ScryfallSearchQuery}" Foreground="#0078D4" FontSize="10"
                                                   TextWrapping="Wrap" MaxHeight="40"/>
                                    </StackPanel>
                                </Border>

                                <!-- Scryfall results (with thumbnails) -->
                                <ListBox ItemsSource="{Binding ScryfallResults}" SelectedItem="{Binding SelectedScryfallCard}"
                                         Height="180" BorderThickness="1" BorderBrush="#444"
                                         Background="#252526" FontSize="11"
                                         MouseDoubleClick="OnScryfallDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Border Width="36" Height="50" Background="#111" CornerRadius="3" Margin="0,0,6,0">
                                                    <Image Source="{Binding ImageUris[small]}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#DDD" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                    <TextBlock FontSize="9" Foreground="#888">
                                                        <Run Text="{Binding SetName, Mode=OneWay}"/>
                                                        <Run Text=" #"/><Run Text="{Binding CollectorNumber, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Preview panel (shown when a result is selected) -->
                                <Border Height="200" Background="#111" CornerRadius="4" Margin="0,6,0,0"
                                        Visibility="{Binding SearchPreviewUrl, Converter={StaticResource NullToCollapsed}, FallbackValue=Collapsed}">
                                    <Image Source="{Binding SearchPreviewUrl}" Stretch="Uniform" Margin="4"/>
                                </Border>

                                <!-- Add button -->
                                <Button Style="{StaticResource AccentBtn}" Command="{Binding AddScryfallCardCommand}"
                                        Content="Add Selected Card" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>

                                <Button Style="{StaticResource ToolBtn}" Command="{Binding UpdateAllArtFromMpcFillCommand}"
                                        Content="Update All Art from MPCFill" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>

                                <!-- Moxfield import -->
                                <TextBlock Text="Import Deck" FontWeight="SemiBold" Foreground="#CCC" Margin="0,16,0,6" FontSize="12"/>
                                <TextBlock Text="Paste a URL from Moxfield or Archidekt" Foreground="#666" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ImportDeckUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,5" FontSize="11"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" BorderThickness="1"
                                             CaretBrush="White" x:Name="DeckImportUrlBox"/>
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}"
                                            Command="{Binding ImportDeckCommand}" Content="Import" Margin="4,0,0,0" Padding="10,5"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IgnoreDuplicates}" Content="Skip cards already in project (merge basics)"
                                          Foreground="#999" FontSize="10" Margin="0,2,0,0"
                                          ToolTip="Cards already in the project are skipped. Basic lands are only added if the deck needs more copies than you already have."/>

                                <TextBlock Text="Import MPCFill Project" FontWeight="SemiBold" Foreground="#CCC" Margin="0,16,0,6" FontSize="12"/>
                                <Button Style="{StaticResource AccentBtn}" Command="{Binding ImportMpcFillXmlCommand}"
                                        Content="Import cards.xml..." HorizontalAlignment="Stretch" Padding="8,6"/>
                                <TextBlock Text="Import a cards.xml file exported from MPCFill" Foreground="#666" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        </avalonDock:LayoutAnchorable>

                        <!-- ===== CARD PANEL ===== -->
                        <avalonDock:LayoutAnchorable Title="Card" ContentId="CardPanel" CanClose="False" CanHide="True" AutoHideWidth="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                                <StackPanel Margin="10,8" DataContext="{Binding SelectedCard}">
                                <TextBlock Text="(Click a card on the page)" Foreground="#666" FontStyle="Italic" FontSize="12" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Name" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Quantity" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Mana Cost" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ManaCost}" Foreground="#CCC" FontSize="12" Padding="6,5"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding TypeLine}" Foreground="#AAA" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OracleText}" Foreground="#888" FontSize="10" TextWrapping="Wrap" MaxHeight="80" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="#666" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10">
                                        <Run Text="{Binding SetName, Mode=OneWay}"/> #<Run Text="{Binding CollectorNumber, Mode=OneWay}"/>
                                        | <Run Text="{Binding Rarity, Mode=OneWay}"/> | <Run Text="{Binding Artist, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Text="Front Artwork" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                    <Button Style="{StaticResource AccentBtn}"
                                            Command="{Binding DataContext.ActiveProject.Inner.BrowseFrontArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="Select Art..." Margin="0,0,0,6" HorizontalAlignment="Stretch" Padding="8,6"/>
                                    <Border Height="150" Background="#111" CornerRadius="4" Margin="0,0,0,4">
                                        <Image Source="{Binding ArtworkPath}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding ArtworkPath}" Foreground="#555" FontSize="9"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                                    <TextBlock Text="Overlay Text" Foreground="#999" FontSize="10" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding OverlayText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="12"
                                             Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="0,0,0,8"/>

                                    <CheckBox Content="Include Back Artwork" IsChecked="{Binding IncludeBack}" Foreground="#CCC" Margin="0,0,0,6"/>
                                    <Button Style="{StaticResource AccentBtn}"
                                            Command="{Binding DataContext.ActiveProject.Inner.BrowseBackArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Content="Select Card Back..." Margin="0,0,0,6" HorizontalAlignment="Stretch" Padding="8,6"/>
                                    <Border Height="150" Background="#111" CornerRadius="4" Margin="0,0,0,4">
                                        <Image Source="{Binding BackArtworkPath}" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <TextBlock Text="{Binding BackArtworkPath}" Foreground="#555" FontSize="9"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </avalonDock:LayoutAnchorable>

                        <!-- ===== LAYOUT PANEL ===== -->
                        <avalonDock:LayoutAnchorable Title="Layout" ContentId="LayoutPanel" CanClose="False" CanHide="True" AutoHideWidth="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                                <StackPanel Margin="10,8">
                                <!-- Page -->
                                <TextBlock Text="PAGE" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Page Size" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PagePresets}" SelectedItem="{Binding SelectedPagePreset}"
                                          Padding="4" Margin="0,0,0,6" FontSize="11"/>
                                <CheckBox Content="Landscape" IsChecked="{Binding CurrentProject.PageSettings.IsLandscape}" Foreground="#CCC" Margin="0,0,0,10"/>

                                <!-- Print -->
                                <TextBlock Text="PRINT" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <TextBlock Text="Print Mode" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PrintModeValues}" SelectedItem="{Binding SelectedPrintMode}"
                                          Padding="4" Margin="0,0,0,6" FontSize="11"/>
                                <CheckBox Content="Cutting guides (edge-to-edge)" IsChecked="{Binding CurrentProject.PrintSettings.ShowCutGuides}" Foreground="#CCC" Margin="0,0,0,6"/>

                                <!-- Card Outline Guides -->
                                <TextBlock Text="CARD OUTLINE" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <CheckBox Content="Show card outline guides" IsChecked="{Binding CurrentProject.PrintSettings.ShowCardOutline}" Foreground="#CCC" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Color" Foreground="#999" FontSize="9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="3" Margin="0,0,4,0"
                                                    BorderBrush="#555" BorderThickness="1" Cursor="Hand"
                                                    Background="{Binding CurrentProject.PrintSettings.OutlineColor}"
                                                    MouseLeftButtonUp="OnOutlineColorClick"/>
                                            <TextBox Grid.Column="1" Text="{Binding CurrentProject.PrintSettings.OutlineColor, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                     Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Line Weight (pt)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.LineWeight, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Alignment" Foreground="#999" FontSize="9"/>
                                        <ComboBox ItemsSource="{Binding OutlineAlignmentOptions}" SelectedItem="{Binding SelectedOutlineAlignment}" Padding="3" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Outline Type" Foreground="#999" FontSize="9"/>
                                        <ComboBox ItemsSource="{Binding OutlineTypeOptions}" SelectedItem="{Binding SelectedOutlineType}" Padding="3" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Corner Radius (mm)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.CornerRadiusMm, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Line Type" Foreground="#999" FontSize="9"/>
                                        <ComboBox ItemsSource="{Binding LineTypeOptions}" SelectedItem="{Binding SelectedLineType}" Padding="3" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Corner Length (mm)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.CornerLengthMm, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,4"/>

                                <!-- Silhouette Cameo -->
                                <TextBlock Text="SILHOUETTE CAMEO" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <CheckBox Content="Add registration marks to PDF" IsChecked="{Binding CurrentProject.PrintSettings.ShowRegistrationMarks}"
                                          Foreground="#CCC" Margin="0,0,0,4"/>
                                <CheckBox Content="Export SVG cut lines with PDF" IsChecked="{Binding CurrentProject.PrintSettings.ExportSvgCutLines}"
                                          Foreground="#CCC" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4"
                                      Visibility="{Binding CurrentProject.PrintSettings.ShowRegistrationMarks, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mark Length (in)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkLengthIn, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Thickness (in)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkThicknessIn, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Inset (in)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PrintSettings.RegMarkInsetIn, UpdateSourceTrigger=LostFocus}" Padding="4,3" FontSize="11"
                                                 Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,4"/>

                                <!-- Card Size -->
                                <TextBlock Text="CARD SIZE" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <ComboBox ItemsSource="{Binding CardSizePresets}" SelectedItem="{Binding SelectedCardSize}"
                                          Padding="4" Margin="0,0,0,6" FontSize="11"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Width (mm)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PageSettings.CardWidthMm, UpdateSourceTrigger=LostFocus}" Padding="4" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Height (mm)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PageSettings.CardHeightMm, UpdateSourceTrigger=LostFocus}" Padding="4" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Bleed (mm)" Foreground="#999" FontSize="9"/>
                                        <TextBox Text="{Binding CurrentProject.PageSettings.BleedWidthMm, UpdateSourceTrigger=LostFocus}" Padding="4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Grid -->
                                <TextBlock Text="GRID" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,12,0,6"/>
                                <TextBlock Text="Leave blank to auto-fit" Foreground="#666" FontSize="9" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Foreground="#999" FontSize="9">
                                            <Run Text="Columns (auto: "/><Run Text="{Binding CurrentProject.PageSettings.AutoCardsPerRow, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <TextBox Text="{Binding CurrentProject.PageSettings.ColumnsOverride, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Padding="4" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Foreground="#999" FontSize="9">
                                            <Run Text="Rows (auto: "/><Run Text="{Binding CurrentProject.PageSettings.AutoCardsPerColumn, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <TextBox Text="{Binding CurrentProject.PageSettings.RowsOverride, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Padding="4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Info -->
                                <TextBlock Text="INFO" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                    <Run Text="Grid: "/><Run Text="{Binding CurrentProject.PageSettings.CardsPerRow, Mode=OneWay}"/>
                                    <Run Text=" x "/><Run Text="{Binding CurrentProject.PageSettings.CardsPerColumn, Mode=OneWay}"/>
                                    <Run Text="  |  "/><Run Text="{Binding CurrentProject.PageSettings.CardsPerPage, Mode=OneWay}"/><Run Text="/page"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                    <Run Text="Page: "/><Run Text="{Binding CurrentProject.PageSettings.PageWidthMm, Mode=OneWay, StringFormat={}{0:0}}"/>
                                    <Run Text=" x "/><Run Text="{Binding CurrentProject.PageSettings.PageHeightMm, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" mm"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAA" FontSize="11" Margin="0,2">
                                    <Run Text="Cards: "/><Run Text="{Binding Cards.Count, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- Storage -->
                                <TextBlock Text="STORAGE" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CacheSizeText}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource ToolBtn}" Command="{Binding ClearCacheCommand}"
                                            Content="Clear Cache" Padding="8,3" FontSize="10"/>
                                </Grid>

                                <!-- Back Art -->
                                <TextBlock Text="BACK ART" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,6,0,6"/>
                                <Button Style="{StaticResource AccentBtn}" Command="{Binding SelectBackArtForAllCommand}"
                                        Content="Select Back for All Cards..." HorizontalAlignment="Stretch" Padding="8,6"/>
                            </StackPanel>
                        </ScrollViewer>
                        </avalonDock:LayoutAnchorable>

                        <!-- ===== FILTER PANEL ===== -->
                        <avalonDock:LayoutAnchorable Title="Filter" ContentId="FilterPanel" CanClose="False" CanHide="True" AutoHideWidth="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2D2D30">
                                <StackPanel Margin="10,8">
                                <TextBlock Text="FILTER" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="Search" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="11"
                                         Background="#3E3E42" Foreground="White" BorderBrush="#555" CaretBrush="White" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Rarity" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding RarityOptions}" SelectedItem="{Binding FilterRarity}" Padding="3" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Color" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding FilterColor}" Padding="3" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SORT" Foreground="#0078D4" FontSize="10" FontWeight="Bold" Margin="0,8,0,6"/>
                                <TextBlock Text="Sort by" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" Padding="3" FontSize="11" Margin="0,0,0,6"/>
                                <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" Foreground="#CCC" Margin="0,0,0,8"/>

                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Style="{StaticResource AccentBtn}" Command="{Binding ApplySortToProjectCommand}" Content="Apply Sort" Margin="0,0,2,0"/>
                                    <Button Style="{StaticResource ToolBtn}" Command="{Binding ClearFilterCommand}" Content="Clear All" Margin="2,0,0,0"/>
                                </UniformGrid>

                                <TextBlock Foreground="#888" FontSize="11" Margin="0,8,0,0">
                                    <Run Text="Showing "/>
                                    <Run Text="{Binding FilteredCards.Count, Mode=OneWay}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding Cards.Count, Mode=OneWay}"/>
                                    <Run Text=" cards"/>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                        </avalonDock:LayoutAnchorable>

                    </avalonDock:LayoutAnchorablePane>
                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="4" Background="#007ACC" Padding="8,3"
                DataContext="{Binding ActiveProject.Inner}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Column="1" Foreground="#CCE8FF" FontSize="11">
                    <Run Text="{Binding Cards.Count, Mode=OneWay}"/> cards  |  v<Run Text="{Binding AppVersion, Mode=OneTime}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ==================== SHELL LOADING OVERLAY ==================== -->
        <Border Grid.RowSpan="5" Background="#CC000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Border Background="#2D2D30" CornerRadius="8" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300"
                    BorderBrush="#0078D4" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse Width="36" Height="36" StrokeThickness="4" Margin="0,0,0,16"
                             HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0078D4" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="ShellSpinSB">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ShellSpinSB"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding LoadingMessage}" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait..." Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ==================== BUSY OVERLAY ==================== -->
        <Border Grid.RowSpan="5" Background="#CC000000"
                DataContext="{Binding ActiveProject.Inner}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <Border Background="#2D2D30" CornerRadius="8" Padding="30,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300"
                    BorderBrush="#0078D4" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse Width="36" Height="36" StrokeThickness="4" Margin="0,0,0,16"
                             HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0078D4" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinSB">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinSB"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait..." Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
